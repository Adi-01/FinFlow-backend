# Environment Mode & Port
NODE_ENV=development
PORT=5000
TZ=Asia/Kolkata

# PostgreSQL Database (Pure Containerized Network DNS)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/finance"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance

# Redis Distributed Cache & Rate Limiting (Pure Containerized Network DNS)
REDIS_URL="redis://redis:6379"

# Authentication (HS256 Session Token)
JWT_SECRET="replace_with_a_secure_random_string_min_32_chars"

# Observability ('dev' for single-line colored logs, 'json' for production JSON)
LOG_FORMAT=dev
ENABLE_VERBOSE_LOGS=false

GEMINI_API_KEY="your-gemini-api-key-here"