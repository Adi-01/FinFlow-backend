# Environment Mode & Port
NODE_ENV=development
PORT=5000
TZ=Asia/Kolkata

# PostgreSQL Database (Containerized Network DNS for docker compose / Railway PostgreSQL URL for production)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/finance"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance

# Redis Distributed Cache & Rate Limiting
REDIS_URL="redis://redis:6379"

# Authentication (HS256 Session Token)
JWT_SECRET="replace_with_a_secure_random_string_min_32_chars"

# Observability ('dev' for single-line colored logs, 'json' for production JSON)
LOG_FORMAT=dev
ENABLE_VERBOSE_LOGS=false

# Gemini AI (Smart Categorization & Monthly Reflection)
GEMINI_API_KEY="your_gemini_api_key_here"

# Cloudinary Configuration (Profile Avatar Uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"